# TrustLedger backend configuration.
# Copy this file to `.env` in the repository root and fill in real values.
# `.env` is gitignored — never commit the real key.

# Redis connection used for disputes, ledgers and the escalation queue.
REDIS_URL=redis://localhost:6379

# Groq API key used by the investigator/decision agents.
# Without it the backend still runs: every dispute escalates to human review.
LLM_API_KEY=
